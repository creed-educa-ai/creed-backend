# Copiar para .env — NUNCA commitar o .env real.
ENVIRONMENT=local
DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=creed
# OBRIGATÓRIO — não tem default na Settings; sem ele a aplicação não sobe.
POSTGRES_PASSWORD=creed
POSTGRES_DB=creed

# Esteira de IA — N8N self-hosted (ADR-001, secao 2.1)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/prognostico
N8N_CALLBACK_SECRET=troque-em-producao

CORS_ORIGINS=http://localhost:5173

# Autenticação — Keycloak local (CREED-23). Sobe pelo docker-compose com o realm
# de docker/keycloak/realm-creed.json já importado.
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=creed
KEYCLOAK_CLIENT_ID=creed-backend
# OBRIGATÓRIO — não tem default na Settings; sem ele a aplicação não sobe.
# Este é o segredo do realm LOCAL, versionado junto com ele. Em qualquer outro
# ambiente o valor vem de Secret e nunca do repositório.
KEYCLOAK_CLIENT_SECRET=creed-local-secret
KEYCLOAK_TIMEOUT_SECONDS=10
KEYCLOAK_JWKS_CACHE_SECONDS=3600
