{
  "$defs": {
    "AlignmentBands": {
      "additionalProperties": false,
      "description": "Quantas pessoas estão em cada faixa de nota de um prisma (P-061).",
      "properties": {
        "baixa": {
          "minimum": 0,
          "title": "Baixa",
          "type": "integer"
        },
        "media": {
          "minimum": 0,
          "title": "Media",
          "type": "integer"
        },
        "alta": {
          "minimum": 0,
          "title": "Alta",
          "type": "integer"
        }
      },
      "required": [
        "baixa",
        "media",
        "alta"
      ],
      "title": "AlignmentBands",
      "type": "object"
    },
    "AlignmentByPrisma": {
      "additionalProperties": false,
      "description": "O alinhamento do grupo em cada um dos cinco prismas. Os cinco vêm sempre.",
      "properties": {
        "seguranca_psicologica": {
          "$ref": "#/$defs/PrismaAlignment"
        },
        "lideranca_adaptativa": {
          "$ref": "#/$defs/PrismaAlignment"
        },
        "cultura_empreendedora": {
          "$ref": "#/$defs/PrismaAlignment"
        },
        "adaptabilidade_cognitiva": {
          "$ref": "#/$defs/PrismaAlignment"
        },
        "neuroinovacao_prisma": {
          "$ref": "#/$defs/PrismaAlignment"
        }
      },
      "required": [
        "seguranca_psicologica",
        "lideranca_adaptativa",
        "cultura_empreendedora",
        "adaptabilidade_cognitiva",
        "neuroinovacao_prisma"
      ],
      "title": "AlignmentByPrisma",
      "type": "object"
    },
    "DepartmentScores": {
      "additionalProperties": false,
      "description": "A nota de um setor. Só vem setor com o piso de respostas (P-089).",
      "properties": {
        "department": {
          "$ref": "#/$defs/DepartmentType"
        },
        "submitted": {
          "description": "Pessoas do setor com resposta enviada.",
          "minimum": 1,
          "title": "Submitted",
          "type": "integer"
        },
        "prismas": {
          "$ref": "#/$defs/PrismaScores"
        }
      },
      "required": [
        "department",
        "submitted",
        "prismas"
      ],
      "title": "DepartmentScores",
      "type": "object"
    },
    "DepartmentType": {
      "description": "Os cinco setores fixos de uma organização.\n\nTipo `department_type` no banco, da tabela `departments`. Compartilhado por\n`department` (o setor cadastrado da empresa) e `links` (o setor que a troca de\nsetor do membro recebe e devolve).",
      "enum": [
        "Marketing",
        "Financeiro",
        "Administrativo",
        "RecursosHumanos",
        "TecnologiaInformacao"
      ],
      "title": "DepartmentType",
      "type": "string"
    },
    "DimensionScores": {
      "additionalProperties": false,
      "description": "Média de cada uma das sete dimensões da Matriz CREED, de 0 a 100.\n\nAs sete vêm sempre: sem uma delas, o back não calcula os prismas.",
      "properties": {
        "S2": {
          "maximum": 100,
          "minimum": 0,
          "title": "S2",
          "type": "number"
        },
        "S4": {
          "maximum": 100,
          "minimum": 0,
          "title": "S4",
          "type": "number"
        },
        "S5A": {
          "maximum": 100,
          "minimum": 0,
          "title": "S5A",
          "type": "number"
        },
        "S5B": {
          "maximum": 100,
          "minimum": 0,
          "title": "S5B",
          "type": "number"
        },
        "S6": {
          "maximum": 100,
          "minimum": 0,
          "title": "S6",
          "type": "number"
        },
        "S7": {
          "maximum": 100,
          "minimum": 0,
          "title": "S7",
          "type": "number"
        },
        "S8": {
          "maximum": 100,
          "minimum": 0,
          "title": "S8",
          "type": "number"
        }
      },
      "required": [
        "S2",
        "S4",
        "S5A",
        "S5B",
        "S6",
        "S7",
        "S8"
      ],
      "title": "DimensionScores",
      "type": "object"
    },
    "IndividualInsightRequest": {
      "additionalProperties": false,
      "description": "Pedido de insight individual: o resultado de uma resposta enviada.\n\nNão leva nada que identifique a pessoa (P-091): nem nome, e-mail, documento,\norganização, setor, dado demográfico ou o id da resposta. O `insight_id` é a\núnica correlação de que o N8N precisa, e ele volta no callback.",
      "properties": {
        "contract_version": {
          "const": "insight-v1",
          "title": "Contract Version",
          "type": "string"
        },
        "scope": {
          "const": "individual",
          "title": "Scope",
          "type": "string"
        },
        "insight_id": {
          "description": "Id do pedido. O callback devolve o mesmo valor.",
          "format": "uuid",
          "title": "Insight Id",
          "type": "string"
        },
        "attempt": {
          "description": "Tentativa de disparo, a partir de 1. Volta igual no callback.",
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "language": {
          "description": "Idioma do texto: o da tela de quem enviou a resposta.",
          "enum": [
            "pt-BR",
            "en",
            "es"
          ],
          "title": "Language",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/InsightResult"
        },
        "open_answers": {
          "description": "Perguntas descritivas respondidas. Vazia se a pessoa não respondeu.",
          "items": {
            "$ref": "#/$defs/OpenAnswer"
          },
          "title": "Open Answers",
          "type": "array"
        }
      },
      "required": [
        "contract_version",
        "scope",
        "insight_id",
        "attempt",
        "language",
        "result",
        "open_answers"
      ],
      "title": "IndividualInsightRequest",
      "type": "object"
    },
    "InsightResult": {
      "additionalProperties": false,
      "description": "O resultado que o texto interpreta, já calculado pelo back.\n\n`destaque` e `oportunidade` são o prisma de maior e o de menor nota, pela mesma\nregra do dashboard. A IA não decide quais são (princípio 1 do projeto).",
      "properties": {
        "prismas": {
          "$ref": "#/$defs/PrismaScores"
        },
        "dimensions": {
          "$ref": "#/$defs/DimensionScores"
        },
        "destaque": {
          "$ref": "#/$defs/Prisma",
          "description": "Prisma de maior nota."
        },
        "oportunidade": {
          "$ref": "#/$defs/Prisma",
          "description": "Prisma de menor nota."
        }
      },
      "required": [
        "prismas",
        "dimensions",
        "destaque",
        "oportunidade"
      ],
      "title": "InsightResult",
      "type": "object"
    },
    "OpenAnswer": {
      "additionalProperties": false,
      "description": "Uma pergunta descritiva respondida, com o texto como a pessoa escreveu.\n\nA resposta é dado, nunca instrução: quem monta o prompt a coloca entre\nmarcadores (spec da CREED-80, \"Segurança na esteira\").",
      "properties": {
        "section": {
          "description": "Seção do questionário, ex.: S9.",
          "minLength": 1,
          "title": "Section",
          "type": "string"
        },
        "question": {
          "description": "Texto da pergunta, em pt-BR.",
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "answer": {
          "description": "Resposta, como foi escrita.",
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        }
      },
      "required": [
        "section",
        "question",
        "answer"
      ],
      "title": "OpenAnswer",
      "type": "object"
    },
    "OrganizationInsightRequest": {
      "additionalProperties": false,
      "description": "Pedido de insight da empresa: o resultado agregado de um período.\n\nSão os números do dashboard da empresa, sem recorte. Não leva nenhuma resposta\naberta (P-090), nem nome de pessoa ou da organização: o texto fala do grupo.",
      "properties": {
        "contract_version": {
          "const": "insight-v1",
          "title": "Contract Version",
          "type": "string"
        },
        "scope": {
          "const": "organization",
          "title": "Scope",
          "type": "string"
        },
        "insight_id": {
          "description": "Id do pedido. O callback devolve o mesmo valor.",
          "format": "uuid",
          "title": "Insight Id",
          "type": "string"
        },
        "attempt": {
          "description": "Tentativa de disparo, a partir de 1. Volta igual no callback.",
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "language": {
          "const": "pt-BR",
          "description": "Idioma do texto, sempre pt-BR: é um texto só por período, para todos os leitores da empresa.",
          "title": "Language",
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/Period"
        },
        "participation": {
          "$ref": "#/$defs/Participation"
        },
        "result": {
          "$ref": "#/$defs/InsightResult"
        },
        "departments": {
          "description": "Setores com o piso de respostas. Vazia se nenhum chega a ele.",
          "items": {
            "$ref": "#/$defs/DepartmentScores"
          },
          "title": "Departments",
          "type": "array"
        },
        "alignment": {
          "$ref": "#/$defs/AlignmentByPrisma"
        }
      },
      "required": [
        "contract_version",
        "scope",
        "insight_id",
        "attempt",
        "language",
        "period",
        "participation",
        "result",
        "departments",
        "alignment"
      ],
      "title": "OrganizationInsightRequest",
      "type": "object"
    },
    "Participation": {
      "additionalProperties": false,
      "description": "Quantas pessoas responderam, de quantas eram do público do período.",
      "properties": {
        "submitted": {
          "description": "Pessoas com resposta enviada.",
          "minimum": 1,
          "title": "Submitted",
          "type": "integer"
        },
        "invited": {
          "description": "Pessoas do público do período.",
          "minimum": 1,
          "title": "Invited",
          "type": "integer"
        }
      },
      "required": [
        "submitted",
        "invited"
      ],
      "title": "Participation",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "description": "O período do questionário que a empresa respondeu.",
      "properties": {
        "opens_at": {
          "description": "Abertura do período.",
          "format": "date-time",
          "title": "Opens At",
          "type": "string"
        },
        "closes_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fechamento do período. Nulo se o período não tem data para fechar.",
          "title": "Closes At"
        }
      },
      "required": [
        "opens_at",
        "closes_at"
      ],
      "title": "Period",
      "type": "object"
    },
    "Prisma": {
      "description": "Os cinco prismas de análise do produto.\n\nTipo `prisma` no banco, compartilhado por `questions` e `insights`. Os\nvalores vêm do material do produto sobre a composição dos prismas\n(SP, LA, CE, AC, NP).",
      "enum": [
        "seguranca_psicologica",
        "lideranca_adaptativa",
        "cultura_empreendedora",
        "adaptabilidade_cognitiva",
        "neuroinovacao_prisma"
      ],
      "title": "Prisma",
      "type": "string"
    },
    "PrismaAlignment": {
      "additionalProperties": false,
      "description": "As faixas de um prisma e a leitura delas (P-062).",
      "properties": {
        "bands": {
          "$ref": "#/$defs/AlignmentBands"
        },
        "level": {
          "enum": [
            "alinhado",
            "moderado",
            "dividido"
          ],
          "title": "Level",
          "type": "string"
        }
      },
      "required": [
        "bands",
        "level"
      ],
      "title": "PrismaAlignment",
      "type": "object"
    },
    "PrismaScores": {
      "additionalProperties": false,
      "description": "Nota de cada um dos cinco prismas, de 0 a 100. Os cinco vêm sempre.",
      "properties": {
        "seguranca_psicologica": {
          "maximum": 100,
          "minimum": 0,
          "title": "Seguranca Psicologica",
          "type": "number"
        },
        "lideranca_adaptativa": {
          "maximum": 100,
          "minimum": 0,
          "title": "Lideranca Adaptativa",
          "type": "number"
        },
        "cultura_empreendedora": {
          "maximum": 100,
          "minimum": 0,
          "title": "Cultura Empreendedora",
          "type": "number"
        },
        "adaptabilidade_cognitiva": {
          "maximum": 100,
          "minimum": 0,
          "title": "Adaptabilidade Cognitiva",
          "type": "number"
        },
        "neuroinovacao_prisma": {
          "maximum": 100,
          "minimum": 0,
          "title": "Neuroinovacao Prisma",
          "type": "number"
        }
      },
      "required": [
        "seguranca_psicologica",
        "lideranca_adaptativa",
        "cultura_empreendedora",
        "adaptabilidade_cognitiva",
        "neuroinovacao_prisma"
      ],
      "title": "PrismaScores",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "individual": "#/$defs/IndividualInsightRequest",
      "organization": "#/$defs/OrganizationInsightRequest"
    },
    "propertyName": "scope"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/IndividualInsightRequest"
    },
    {
      "$ref": "#/$defs/OrganizationInsightRequest"
    }
  ]
}
